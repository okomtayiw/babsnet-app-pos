<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.babsnet.posapp.controller.UserController"
      spacing="20" alignment="TOP_CENTER" style="-fx-padding: 20px;">

    <Label text="Manajemen User" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <!-- Form input -->
    <GridPane hgap="10" vgap="10">
        <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="usernameField" GridPane.rowIndex="0" GridPane.columnIndex="1" />

        <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <PasswordField fx:id="passwordField" GridPane.rowIndex="1" GridPane.columnIndex="1" />

        <Label text="First Name:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="firstNameField" GridPane.rowIndex="2" GridPane.columnIndex="1" />

        <Label text="Last Name:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="lastNameField" GridPane.rowIndex="3" GridPane.columnIndex="1" />

        <Label text="Phone:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="phoneField" GridPane.rowIndex="4" GridPane.columnIndex="1" />

        <Label text="Email:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="emailField" GridPane.rowIndex="5" GridPane.columnIndex="1" />

        <Label text="Role:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <ComboBox fx:id="roleComboBox" GridPane.rowIndex="6" GridPane.columnIndex="1" prefWidth="180"/>
    </GridPane>

    <HBox spacing="12">
        <Button text="Baru" onAction="#handleNew"/>
        <Button text="Simpan" onAction="#handleSave"/>
        <Button text="Hapus" onAction="#handleDelete"/>
        <Button text="Clear" onAction="#handleClear"/>
    </HBox>

    <TableView fx:id="userTable" prefHeight="320" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="ID" fx:id="colId" prefWidth="40"/>
            <TableColumn text="Username" fx:id="colUsername" prefWidth="110"/>
            <TableColumn text="Nama" fx:id="colName" prefWidth="140"/>
            <TableColumn text="Phone" fx:id="colPhone" prefWidth="90"/>
            <TableColumn text="Email" fx:id="colEmail" prefWidth="160"/>
            <TableColumn text="Role" fx:id="colRole" prefWidth="80"/>
        </columns>
    </TableView>
</VBox>
