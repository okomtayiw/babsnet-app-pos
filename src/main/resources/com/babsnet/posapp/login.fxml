<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.babsnet.posapp.controller.LoginController"
           style="-fx-background-color: #f0f4f8;">
    <VBox alignment="CENTER" spacing="20" prefWidth="350" prefHeight="240"
          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 38 24 26 24;">
        <Text text="Welcome to Babsnet POS" style="-fx-font-size: 19px; -fx-fill: #333; -fx-font-weight: bold;"/>

        <GridPane hgap="10" vgap="12">
            <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="usernameField" promptText="Enter username"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"
                       prefWidth="155"/>

            <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <PasswordField fx:id="passwordField" promptText="Enter password"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"
                           prefWidth="155"/>

            <Button text="Login"
                    fx:id="loginButton"
                    onAction="#handleLogin"
                    style="-fx-background-color: #42ad51; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"
                    GridPane.rowIndex="2" GridPane.columnIndex="1"
                    GridPane.halignment="CENTER"
                    minWidth="110" maxWidth="Infinity"/>
        </GridPane>
        <Label fx:id="errorLabel"
               text=""
               style="-fx-text-fill: #e53935; -fx-font-size: 12px; -fx-padding: 0 0 0 4;"
               visible="false"
               managed="false"/>
    </VBox>
</StackPane>
